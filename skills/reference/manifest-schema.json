{
  "$defs": {
    "AddRelationOperation": {
      "additionalProperties": false,
      "properties": {
        "relation_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "target_work_key": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Target Work Key",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "op": {
          "const": "add_relation",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "target_work_key",
        "op"
      ],
      "title": "AddRelationOperation",
      "type": "object"
    },
    "AddSectionsOperation": {
      "additionalProperties": false,
      "properties": {
        "before_section_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Section Id"
        },
        "after_section_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Section Id"
        },
        "op": {
          "const": "add_sections",
          "title": "Op",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/CorpusSectionManifest"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "op",
        "parent_id",
        "sections"
      ],
      "title": "AddSectionsOperation",
      "type": "object"
    },
    "CorpusAppendSectionManifest": {
      "additionalProperties": false,
      "properties": {
        "section_key": {
          "maxLength": 255,
