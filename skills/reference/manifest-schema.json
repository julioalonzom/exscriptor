              "type": "null"
            }
          ],
          "default": null,
          "title": "Title Translations"
        },
        "texts": {
          "items": {
            "$ref": "#/$defs/CorpusTextManifest"
          },
          "maxItems": 32,
          "title": "Texts",
          "type": "array"
        },
        "parent_path": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Path"
        }
      },
      "required": [
        "section_key",
        "title",
        "slug",
        "section_type"
      ],
      "title": "CorpusAppendSectionManifest",
      "type": "object"
    },
