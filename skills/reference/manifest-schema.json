    "CorpusEditWork": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "import_mode": {
          "const": "edit",
          "title": "Import Mode",
          "type": "string"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_relation": "#/$defs/AddRelationOperation",
                "add_sections": "#/$defs/AddSectionsOperation",
                "delete_section": "#/$defs/DeleteSectionOperation",
                "move_section": "#/$defs/MoveSectionOperation",
                "put_text": "#/$defs/PutTextOperation",
                "remove_relation": "#/$defs/RemoveRelationOperation",
                "set_facsimile": "#/$defs/SetFacsimileOperation",
                "update_section": "#/$defs/UpdateSectionOperation",
                "update_work": "#/$defs/UpdateWorkOperation"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AddSectionsOperation"
              },
              {
                "$ref": "#/$defs/PutTextOperation"
              },
              {
                "$ref": "#/$defs/UpdateSectionOperation"
              },
              {
                "$ref": "#/$defs/MoveSectionOperation"
              },
              {
                "$ref": "#/$defs/DeleteSectionOperation"
              },
              {
                "$ref": "#/$defs/UpdateWorkOperation"
              },
              {
                "$ref": "#/$defs/AddRelationOperation"
              },
              {
                "$ref": "#/$defs/RemoveRelationOperation"
              },
              {
                "$ref": "#/$defs/SetFacsimileOperation"
              }
            ]
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "slug",
        "import_mode",
        "operations"
      ],
      "title": "CorpusEditWork",
      "type": "object"
    },
