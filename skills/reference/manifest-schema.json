        "author_key": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Author Key",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "slug": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "birth_year": {
          "anyOf": [
            {
              "type": "integer"
